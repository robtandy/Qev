+/* Every opaque edge-solved span was painted by the surface rasterizer above.
+ * Record the same 2D coverage, including brush pickups; do not inspect its depth. */
+static void Qev_LabelSurface(surf_t *s)
+{
+	espan_t *span;
+	if (!qev_pixel_capture) return;
+	Qev_DrawEntity(s->insubmodel ? s->entity : NULL);
+	for (span = s->spans; span; span = span->pnext)
+		Qev_PixelsSpan(d_viewbuffer + screenwidth * span->v + span->u, span->count);
+}
+
 void D_DrawSurfaces (void)
 {
 	surf_t			*s;
@@ -194,6 +205,7 @@ void D_DrawSurfaces (void)
 
 			D_DrawSolidSurface (s, (int)s->data & 0xFF);
 			D_DrawZSpans (s->spans);
+			Qev_LabelSurface(s);
 		}
 	}
 	else
@@ -322,6 +334,7 @@ void D_DrawSurfaces (void)
 					R_TransformFrustum ();
 				}
 			}
+			Qev_LabelSurface(s);
 		}
 	}
 }

{
  "name": "qev",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An inspectable Kevala decision-model controller for classic Quake via Qwasm.",
  "engines": { "node": ">=22" },
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "setup:engine": "bash scripts/setup-toolchain.sh",
    "setup:demo": "node scripts/setup-demo.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "check": "node scripts/check.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": { "kevala": "0.1.3" }
}
